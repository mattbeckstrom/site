<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description }}">
  <title>{{ title }}{% if title != "Home" %} — Matt Beckstrom{% endif %}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header>
  <div class="wrap nav">
    <a class="logo" href="/"><span>~/</span>mattbeckstrom</a>
    <nav aria-label="Main navigation">
      <ul>
        <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/cv.html" {% if page.url == '/cv.html' %}aria-current="page"{% endif %}>CV</a></li>
        <li><a href="/writing.html" {% if page.url == '/writing.html' %}aria-current="page"{% endif %}>Writing</a></li>
        <li><a href="/presentations.html" {% if page.url == '/presentations.html' %}aria-current="page"{% endif %}>Presentations</a></li>
        <li><a href="/academics.html" {% if page.url == '/academics.html' %}aria-current="page"{% endif %}>Academics</a></li>
        <li><a href="/contact.html" {% if page.url == '/contact.html' %}aria-current="page"{% endif %}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main" class="wrap">
  {{ content | safe }}
</main>

<footer class="wrap">
  <span>© {{ site.year }} Matt Beckstrom</span>
  <span>no trackers · no analytics · no third-party requests</span>
</footer>

<script src="/js/filter.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
